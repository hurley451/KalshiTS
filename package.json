{
  "name": "@hurley451/kalshi-ts",
  "version": "0.1.0-alpha.1",
  "private": false,
  "kalshiCoreRef": "99abf30c3fc818815e99f015299e2f4bcbf62a00",
  "description": "TypeScript and JavaScript SDK for Kalshi with named REST endpoints, typed models, contract validation, and RSA-PSS or Ed25519 signing.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hurley451/KalshiTS.git"
  },
  "homepage": "https://github.com/hurley451/KalshiTS#readme",
  "bugs": {
    "url": "https://github.com/hurley451/KalshiTS/issues"
  },
  "keywords": [
    "kalshi",
    "kalshi-api",
    "prediction-markets",
    "trading-api",
    "fintech",
    "sdk",
    "typescript",
    "javascript",
    "nodejs",
    "rest",
    "rsa-pss"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "src/generated/coverage.json",
    "src/generated/schema-coverage.json",
    "src/generated/pagination-coverage.json",
    "src/generated/perps-rest/*.json",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "docs/API_COVERAGE.md",
    "docs/RELEASES.md",
    "docs/VISIBILITY.md"
  ],
  "scripts": {
    "generate:client": "node scripts/generate-client.mjs",
    "generate:operations": "node scripts/generate-operations.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "conformance": "node dist/scripts/conformance.js",
    "test:package": "node scripts/package-smoke.mjs",
    "test": "npm run build && node --test dist/test/*.test.js test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "openapi-sampler": "^1.7.6",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1"
  }
}
